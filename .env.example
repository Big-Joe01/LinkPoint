# =============================================================================
# LinkPoint environment configuration (example — NO real credentials).
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- App ----
NODE_ENV=production
APP_URL=https://api.your-domain.com
PORT=8080
API_PREFIX=/api
CORS_ORIGINS=https://admin.your-domain.com,https://app.your-domain.com

# ---- Deployment ports (docker-compose.prod.yml) ----
BACKEND_PORT=8080
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# ---- Database (MySQL) ----
# Local dev points at localhost; in docker-compose.prod.yml the host is `mysql`.
DATABASE_URL="mysql://linkpoint:CHANGE_ME@localhost:3306/linkpoint"
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_DATABASE=linkpoint
MYSQL_USER=linkpoint
MYSQL_PASSWORD=CHANGE_ME_strong_password
MYSQL_PORT=3306

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---- Flutterwave (server-side only) ----
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your-flutterwave-webhook-secret-hash
FLUTTERWAVE_API_BASE=https://api.flutterwave.com/v3

# ---- Cloudinary (media) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Maps ----
MAPS_API_KEY=your-maps-api-key

# ---- Wallet / payment safety ----
WALLET_WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400

# ---- Mobile deep links ----
DEEP_LINK_SCHEME=linkpoint
