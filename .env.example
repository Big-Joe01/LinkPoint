# =============================================================================
# LinkPoint environment configuration (example — NO real credentials).
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:8080
PORT=8080
API_PREFIX=/api
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ---- Database (MySQL) ----
DATABASE_URL="mysql://linkpoint:linkpointpass@localhost:3306/linkpoint"
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=linkpoint
MYSQL_USER=linkpoint
MYSQL_PASSWORD=linkpointpass
MYSQL_PORT=3306

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---- Flutterwave (server-side only) ----
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your-flutterwave-webhook-secret-hash
FLUTTERWAVE_API_BASE=https://api.flutterwave.com/v3

# ---- Cloudinary (media) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Maps ----
MAPS_API_KEY=your-maps-api-key

# ---- Wallet / payment safety ----
WALLET_WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400

# ---- Mobile deep links ----
DEEP_LINK_SCHEME=linkpoint
