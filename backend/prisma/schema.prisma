// LinkPoint Prisma schema — MySQL, normalized, indexed.
// Money is stored as BIGINT minor-units (kobo/cents) for safe integer arithmetic.
// NO seed data. Production starts empty.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum UserRole {
  CUSTOMER
  REALTOR
  PROPERTY_OWNER
  INSPECTION_AGENT
  AFFILIATE
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  RESTRICTED
  SUSPENDED
  BANNED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyPurpose {
  SALE
  RENT
  LEASE
  SHORT_LET
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  LUXURY
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  UNDER_OFFER
  SOLD
  RENTED
  ARCHIVED
}

enum WalletTxnType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  COMMISSION
  REFUND
  REVERSAL
  PAYOUT
}

enum WalletTxnStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED
}

enum InspectionStatus {
  REQUESTED
  SEARCHING
  ASSIGNED
  ACCEPTED
  SCHEDULED
  EN_ROUTE
  STARTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  INITIATED
  FUNDED
  ACCEPTED_BY_BUYER
  ACCEPTED_BY_SELLER
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum AdStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  COMPLETED
}

enum ModerationState {
  WARNING
  RESTRICTED
  SUSPENDED
  BANNED
}

enum ConversationType {
  PROPERTY
  INSPECTION
  TRANSACTION
  SUPPORT
  DIRECT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  BLOCKED
}

// ===================== USERS =====================

model User {
  id                 String             @id @default(uuid())
  name               String
  email             String             @unique
  phone             String
  passwordHash      String
  profileImage      String?
  roles             Json               // UserRole[] — supports multiple capabilities
  status            UserStatus         @default(PENDING)
  emailVerified     Boolean            @default(false)
  emailVerifyToken  String?
  phoneVerified     Boolean            @default(false)
  walletPinHash     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastLoginAt       DateTime?

  customer          CustomerProfile?
  realtor           RealtorProfile?
  agent             AgentProfile?
  affiliate         AffiliateProfile?
  wallet            Wallet?
  subscriptions     Subscription[]
  properties        Property[]         @relation("PropertyOwner")
  inspectionsAsCustomer Inspection[]   @relation("InspectionCustomer")
  transactionsAsBuyer Transaction[]     @relation("TransactionBuyer")
  transactionsAsSeller Transaction[]   @relation("TransactionSeller")
  offers            Offer[]
  conversations     ConversationParticipant[]
  messages          Message[]
  ads               Advertisement[]
  affiliateLinks    AffiliateLink[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  bankAccounts      BankAccount[]
  notifications     Notification[]
  reviewsGiven      Review[]           @relation("ReviewAuthor")
  reviewsReceived   Review[]           @relation("ReviewSubject")
  reports           Report[]          @relation("ReportAuthor")
  moderationEvents  ModerationEvent[]  @relation("ModerationTarget")

  @@index([status])
  @@index([email])
}

model CustomerProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model RealtorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String   // REALTOR | PROPERTY_OWNER | BOTH
  businessName    String?
  businessRegNo   String?
  verification    VerificationStatus @default(UNVERIFIED)
  verificationDocs Json?
  active          Boolean  @default(false) // active listing member (subscribed + approved)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AgentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingCities  Json     // string[]
  latitude         Float?
  longitude        Float?
  availability     Boolean  @default(true)
  rating           Float    @default(0)
  verification     VerificationStatus @default(UNVERIFIED)
  verificationDocs Json?
  acceptanceRate   Float    @default(0)
  completedJobs    Int      @default(0)
  activeJobs       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inspections      Inspection[] @relation("InspectionAgent")
  reviews          Review[]
}

model AffiliateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode    String   @unique
  verification    VerificationStatus @default(UNVERIFIED)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String  @unique
  device    String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===================== WALLET + LEDGER =====================

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Balance is DERIVED from ledger. This column is a cached/reconciled value, not source of truth.
  balanceMinor BigInt   @default(0)
  pendingMinor BigInt   @default(0)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId        String
  type          WalletTxnType
  status        WalletTxnStatus @default(PENDING)
  amountMinor   BigInt
  currency      String          @default("NGN")
  reference     String          @unique // unique ledger reference — idempotency key
  source        String?         // FLUTTERWAVE | INSPECTION | TRANSACTION | SUBSCRIPTION | AD | AFFILIATE
  destination   String?
  metadata      Json?
  inspectionId  String?         @unique
  inspection    Inspection?     @relation(fields: [inspectionId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([walletId])
  @@index([userId])
  @@index([reference])
  @@index([status])
}

model BankAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode     String
  bankName     String
  accountNumber String
  accountName  String
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ===================== PROPERTIES =====================

model Property {
  id              String        @id @default(uuid())
  ownerId         String
  owner           User          @relation("PropertyOwner", fields: [ownerId], references: [id])
  title           String
  description     String       @db.Text
  propertyType    PropertyType
  purpose         PropertyPurpose
  priceMinor      BigInt
  currency        String        @default("NGN")
  bedrooms        Int           @default(0)
  bathrooms       Int           @default(0)
  landSize        Float?
  buildingSize    Float?
  amenities       Json          // string[]
  media           Json          // string[] (Cloudinary URLs)
  videos          Json          // string[]
  latitude        Float
  longitude       Float
  // Exact address PROTECTED — only exposed after permitted inspection stage / to assigned agent.
  exactAddress    String
  city            String
  state           String
  country         String        @default("Nigeria")
  area            String?
  status          PropertyStatus @default(DRAFT)
  verification    VerificationStatus @default(UNVERIFIED)
  affiliateEnabled Boolean      @default(false)
  affiliateCommissionPct Float?  // enforced 4..6 by app + DB check
  featured        Boolean       @default(false)
  viewCount       Int           @default(0)
  saveCount       Int           @default(0)
  inquiryCount    Int           @default(0)
  inspectionRequestCount Int    @default(0)
  completedInspectionCount Int  @default(0) // only incremented on actual completion
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  favorites       Favorite[]
  inspections     Inspection[]
  transactions    Transaction[]  @relation("TransactionProperty")
  offers          Offer[]
  ads             Advertisement[]
  affiliateLinks  AffiliateLink[]
  reviews         Review[]

  @@index([status])
  @@index([city])
  @@index([state])
  @@index([purpose])
  @@index([propertyType])
  @@index([ownerId])
  @@index([featured])
}

// ===================== SUBSCRIPTIONS =====================

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String
  priceMinor      BigInt
  currency        String   @default("NGN")
  billingCycleDays Int
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  subscriptions  Subscription[]
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(PENDING)
  startAt         DateTime?
  expireAt        DateTime?
  paymentRef      String?
  autoRenew       Boolean            @default(false)
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// ===================== INSPECTIONS =====================

model Inspection {
  id              String           @id @default(uuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  customerId      String
  customer        User             @relation("InspectionCustomer", fields: [customerId], references: [id])
  agentId         String?
  agent           AgentProfile?    @relation("InspectionAgent", fields: [agentId], references: [id])
  status          InspectionStatus @default(REQUESTED)
  feeMinor        BigInt
  agentCommissionMinor BigInt @default(0) // configurable % of fee
  currency        String           @default("NGN")
  preferredDate   DateTime
  preferredTime   String
  notes           String?
  agentNotes      String?          @db.Text
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?        // set when actual inspection ends
  customerConfirmedAt DateTime?
  agentConfirmedAt DateTime?
  paymentRef      String?
  report          String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  walletTransaction WalletTransaction?
  conversation    Conversation?
  transaction     Transaction?

  @@index([propertyId])
  @@index([customerId])
  @@index([agentId])
  @@index([status])
}

// ===================== TRANSACTIONS / OFFERS =====================

model Offer {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  amountMinor BigInt
  currency    String   @default("NGN")
  note        String?
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  transactionId String? @unique
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([buyerId])
}

model Transaction {
  id              String            @id @default(uuid())
  propertyId      String
  property        Property          @relation("TransactionProperty", fields: [propertyId], references: [id])
  buyerId         String
  buyer           User              @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User              @relation("TransactionSeller", fields: [sellerId], references: [id])
  amountMinor     BigInt
  currency        String            @default("NGN")
  linkpointCommissionMinor BigInt @default(0)
  affiliateCommissionMinor BigInt @default(0)
  status          TransactionStatus @default(INITIATED)
  buyerAcceptedAt DateTime?
  sellerAcceptedAt DateTime?
  agreementVersion String?
  buyerIp          String?
  sellerIp         String?
  fundedAt        DateTime?
  completedAt     DateTime?
  affiliateLinkId String?
  inspectionId    String? @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  milestones      TransactionMilestone[]
  inspection      Inspection?       @relation(fields: [inspectionId], references: [id])
  offer           Offer?

  @@index([propertyId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model TransactionMilestone {
  id            String         @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  code          String         // e.g. INSPECTION_COMPLETED, BUYER_PAYMENT_RECEIVED
  label         String
  status        MilestoneStatus @default(PENDING)
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())

  @@unique([transactionId, code])
  @@index([transactionId])
}

// ===================== AFFILIATE =====================

model AffiliateLink {
  id                  String   @id @default(uuid())
  affiliateId        String
  affiliate          User     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id])
  slug               String   @unique // secure attribution token
  commissionPct      Float    // 4..6 enforced
  clicks              Int      @default(0)
  leads               Int      @default(0)
  conversions         Int      @default(0)
  commissionEarnedMinor BigInt @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([affiliateId])
  @@index([propertyId])
}

model AffiliateClick {
  id            String   @id @default(uuid())
  affiliateLinkId String
  sessionId     String?
  ipHash        String?
  userAgent     String?
  converted     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([affiliateLinkId])
}

// ===================== ADVERTISING =====================

model Advertisement {
  id           String   @id @default(uuid())
  advertiserId String
  advertiser   User     @relation(fields: [advertiserId], references: [id])
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  objective    String
  adType       String   // VIDEO | IMAGE
  mediaUrl     String
  budgetMinor  BigInt
  spentMinor   BigInt   @default(0)
  durationDays Int
  startAt      DateTime?
  endAt        DateTime?
  status       AdStatus @default(PENDING_PAYMENT)
  paymentRef   String?
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([advertiserId])
  @@index([status])
}

// ===================== MESSAGING =====================

model Conversation {
  id            String   @id @default(uuid())
  type          ConversationType
  propertyId    String?
  inspectionId  String?  @unique
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  ConversationParticipant[]
  messages      Message[]
  inspection    Inspection? @relation(fields: [inspectionId], references: [id])
}

model ConversationParticipant {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt      DateTime?
  createdAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id])
  body           String        @db.Text
  filteredBody   String?       @db.Text
  type           String        @default("TEXT")
  status         MessageStatus @default(SENT)
  blocked        Boolean       @default(false)
  blockReasons   Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ===================== MODERATION =====================

model ModerationEvent {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation("ModerationTarget", fields: [userId], references: [id], onDelete: Cascade)
  type        String          // e.g. BLOCKED_MESSAGE, EXTERNAL_LINK, SUSPICIOUS_PAYOUT
  severity    String          @default("LOW")
  state       ModerationState @default(WARNING)
  description String?
  metadata    Json?
  resolved    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model Report {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("ReportAuthor", fields: [authorId], references: [id])
  subjectType String   // PROPERTY | USER | AGENT | MESSAGE | LISTING
  subjectId   String
  reason      String
  details     String?  @db.Text
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  @@index([subjectId])
}

model Review {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId   String
  subject     User     @relation("ReviewSubject", fields: [subjectId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  agentId     String?
  agent       AgentProfile? @relation(fields: [agentId], references: [id])
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([subjectId])
  @@index([propertyId])
  @@index([agentId])
}

// ===================== FAVORITES =====================

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

// ===================== NOTIFICATIONS =====================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  title     String
  body      String  @db.Text
  data      Json?
  read      Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===================== AUDIT LOG =====================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String?
  resourceId String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// ===================== PLATFORM SETTINGS (admin-configurable) =====================

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// ===================== WEBHOOK EVENTS (idempotency) =====================

model WebhookEvent {
  id           String   @id @default(uuid())
  provider     String   // FLUTTERWAVE
  eventId      String   @unique
  eventType    String
  reference    String?
  status       String   @default("PROCESSED")
  payload      Json
  processedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([reference])
}
